# What the APPLICATION needs at run time. Single source of truth.
#
# COMMITTED ON PURPOSE: it holds no value, only `op://` references. CI resolves
# them with `op inject` and ships the resolved file to the server, so this file
# is the ONE place a runtime variable is declared. Add a line here and the
# deploy carries it — there is no second list to keep in step.
#
#   local dev   op run --env-file=.env -- <cmd>   (or `make dev`)
#   CI         op inject -i .env -o …             then scp to the server
#
# What does NOT belong here: SSH_*, TS_OAUTH_* and anything else only the
# DEPLOY needs. Verified 2026-09-04 — no code under src/ reads them. They live
# in .github/workflows/ci-cd.yml, which is the only thing that uses them. That
# split is what removed the duplication: one place per concern, not one file
# holding both and forcing every variable to be declared twice.
#
# What also does not belong here: configuration that is not secret. A path or a
# public URL grants no access, so it goes in src/config.py where it can be read
# without opening a vault.

# Development by default, and the direction is deliberate: an oversight yields
# dev, never a production stack quietly running dev settings. The deploy job
# overrides it to Production on the server.
PYTHON_ENV=Development

SENTRY_DSN=op://Dev/Env/SENTRY_DSN_SHAZAMER

# SLSKD_URL is internal Docker-network config rather than a secret, but it also
# acts as a FEATURE FLAG: soulseek_configured() tests nothing but its presence
# (src/acquire/resolve.py), so emptying it silently switches Soulseek off.
# Explicit here rather than buried in a default.
SLSKD_URL=http://slskd:5030
SLSKD_API_KEY=op://Dev/Env/SLSKD_API_KEY
SLSKD_SLSK_USERNAME=op://Dev/Env/SLSKD_SLSK_USERNAME
SLSKD_SLSK_PASSWORD=op://Dev/Env/SLSKD_SLSK_PASSWORD

SMTP_HOST=op://Dev/EmailsAPI/hostname
SMTP_PORT=op://Dev/EmailsAPI/port
SMTP_USER=op://Dev/EmailsAPI/username
SMTP_PASSWORD=op://Dev/EmailsAPI/identifiant
MAIL_FROM=op://Dev/EmailsAPI/username
