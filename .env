# Reference file for local development.
#
# COMMITTED ON PURPOSE. It holds no secret value — only `op://` references that
# 1Password resolves at run time. Run the app through `op run --env-file=.env`
# (or `make dev`, which does it for you) and the real values never touch disk.
#
# What belongs here: anything whose disclosure grants ACCESS — tokens, keys,
# passwords. Everything else is configuration and lives in the code, where it
# can be read without opening a vault. That distinction is the whole point;
# blur it and a file nobody can read gets treated carelessly everywhere.
#
# CI does not read this file. .github/workflows/ci-cd.yml carries the same
# references in its own 1Password step, and the values it needs come from the
# `Dev` vault via OP_SERVICE_ACCOUNT_TOKEN — the only secret still held by
# GitHub, alongside its own GITHUB_TOKEN.

# Development here, and deliberately so: an oversight yields dev, never a
# production stack running with dev settings. Production is set by the deploy
# job, which writes PYTHON_ENV=Production into the server's own .env.
PYTHON_ENV=Development

# ── Secrets ──────────────────────────────────────────────────────────────
SENTRY_DSN=op://Dev/Env/SENTRY_DSN_SHAZAMER

SLSKD_API_KEY=op://Dev/Env/SLSKD_API_KEY
SLSKD_SLSK_USERNAME=op://Dev/Env/SLSKD_SLSK_USERNAME
SLSKD_SLSK_PASSWORD=op://Dev/Env/SLSKD_SLSK_PASSWORD

SMTP_HOST=op://Dev/EmailsAPI/hostname
SMTP_PORT=op://Dev/EmailsAPI/port
SMTP_USER=op://Dev/EmailsAPI/username
SMTP_PASSWORD=op://Dev/EmailsAPI/identifiant
MAIL_FROM=op://Dev/EmailsAPI/username

# ── Not secrets, kept here for a reason ──────────────────────────────────
#
# SLSKD_URL is internal Docker-network configuration, but it also acts as a
# FEATURE FLAG: soulseek_configured() tests nothing but its presence
# (src/acquire/resolve.py). Emptying it silently switches Soulseek off, so it
# stays explicit rather than being buried in a default.
SLSKD_URL=http://slskd:5030

# Moved OUT of this file on 2026-09-04, because none of them were secrets:
#   DEPLOY_PATH  → the workflow. A path grants no access, and the server
#                  refuses password authentication anyway.
#   PUBLIC_URL   → src/config.py, per environment.
#   SSH_*, TS_*  → the workflow's own 1Password step; nothing local uses them.
#   GHP_TOKEN    → dropped. Replaced by GITHUB_TOKEN on 2026-09-02.
