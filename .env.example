# Environment
PYTHON_ENV=Production

# Sentry (leave empty to disable)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.0

# Analysis
# Parallel Shazam requests. 8 is comfortable; shazamio retries 429s itself.
SHAZAM_CONCURRENCY=8
# Largest upload accepted, in bytes (default 2 GB).
MAX_UPLOAD_BYTES=2147483648
# How long a set's audio is kept. 0 — the default — means indefinitely.
#
# It used to be 14 days, which turned a library into a fortnight's library:
# the tracklist survived but you could no longer hear the moment a track was
# claimed for, which is most of why the tracklist is worth having. Measured
# before changing it: six sets take 325 MB, about 54 MB each, against 69 GB
# free — room for roughly thirteen hundred.
KEEP_AUDIO_DAYS=0
# The real limit. When free space falls below this many gigabytes, the oldest
# set audio is dropped until it is back above — applied when it bites rather
# than on a timer, and oldest first, because this morning's set is the one you
# are listening to and last year's can be fetched from its source again.
MIN_FREE_DISK_GB=5

# Job queue. Analyses run in the worker container and survive a redeploy when
# this is set; without it the API runs them in-process, which works but loses
# whatever is in flight on any restart.
REDIS_URL=redis://redis:6379
# Ceiling for one analysis. High on purpose — a three-hour set is legitimate
# work, and this exists to catch a wedged worker, not to bound normal runs.
JOB_TIMEOUT_SECONDS=14400
# Attempts per job. Higher than it looks like it should be: a container being
# replaced counts as an attempt, so a couple of deploys must not be enough to
# abandon an hour of analysis.
JOB_MAX_TRIES=6

# Metadata enrichment (MusicBrainz). Runs after an analysis and fills in label,
# catalogue number and year. Their API is rate-limited by IP and requires a
# contact address in the User-Agent — a generic one is refused.
MUSICBRAINZ_CONTACT=https://github.com/PierreGallet/shazamer
# Seconds between requests. Their limit is 1/s; 1.1 still drew 503s from a
# shared address, so the default is wider. Enrichment runs in the background.
MUSICBRAINZ_INTERVAL=1.5
# Match score below which a result is discarded. A wrong label is worse than
# none — it sends you hunting for a release that does not exist.
MUSICBRAINZ_MIN_SCORE=88

# Browser origins allowed to call the API (comma-separated).
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000

# Soulseek via slskd — optional, off unless SLSKD_URL is set.
# Requires your own Soulseek account and a shared folder; the network runs on
# reciprocity. See https://github.com/slskd/slskd
SLSKD_URL=
SLSKD_API_KEY=
# slskd needs its own Soulseek session. Note that the network does not allow
# the same account in two places at once — running it here will fight a desktop
# client logged in with the same credentials.
SLSKD_SLSK_USERNAME=
SLSKD_SLSK_PASSWORD=
# Where slskd writes finished transfers, as this container sees it. Both
# containers must agree on this path or the file is downloaded and then lost.
SLSKD_DOWNLOADS_DIR=/slskd-downloads
# Abandon a transfer stalled at the same percentage for this long. Soulseek
# queues are genuinely slow, so this measures stalling rather than duration.
SLSKD_STALL_SECONDS=600
# Reject a downloaded file whose fingerprint is not the track that was asked
# for. Soulseek filenames are whatever the uploader typed; a wrong record filed
# under the right name is found out at the decks.
ACQUIRE_REQUIRE_VERIFICATION=true
# What "best quality" means, since it depends on where the file is going.
#   portable  MP3/AAC first — plays in every DJ app and on every phone, and is
#             about a third the size. FLAC does not import into Apple Music.
#   lossless  FLAC first. Right for Rekordbox, Serato or Traktor.
#   apple     ALAC and AAC first, FLAC last.
ACQUIRE_FORMAT_PROFILE=portable

# How long a downloaded track is kept. Far longer than set audio, because a
# download is a record you went looking for — and on this server it is also
# what gets shared back to Soulseek in return for what you take.
KEEP_DOWNLOADS_DAYS=180

# ── Accounts ─────────────────────────────────────────────────────────────
# On by default — you do not need this line. Secure by default: an install
# that sets nothing gets accounts rather than an open library.
#
# Set it to 0 only for local work with no SMTP configured, where there would
# otherwise be no way to receive a code and therefore no way in.
# AUTH_ENABLED=1

# Where the sign-in code is emailed from. SMTP rather than a provider SDK,
# because every service worth using offers one — so switching provider is a
# change here rather than a change of code.
#
#   Gmail     smtp.gmail.com:587, an *app password*, not the account password
#   Fastmail  smtp.fastmail.com:465 with SMTP_SSL=1
#   Resend    smtp.resend.com:587, user "resend", password = the API key
#   Postmark  smtp.postmarkapp.com:587, user and password = the server token
#
# Deliverability is worth a thought: mail sent from a domain with no SPF or
# DKIM record tends to land in spam, and a sign-in code in spam is a sign-in
# that did not work. A transactional provider handles that for you.
#
# Leave SMTP_HOST empty and codes are written to the log instead — fine
# locally, and refused outright when AUTH_ENABLED=1, so nothing silently
# pretends to have sent a mail it did not send.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# 1 for implicit TLS on connect (port 465). Leave empty for STARTTLS (587).
SMTP_SSL=
# STARTTLS, on by default. Set to 0 only for a relay on this same machine —
# a login code crossing a network in clear is a login code anyone can use.
SMTP_STARTTLS=1
MAIL_FROM=shazamer@pierregallet.com
MAIL_FROM_NAME=Shazamer

# Session cookie. The defaults are right for production behind HTTPS; set
# COOKIE_SECURE=0 only to sign in over plain http locally, and never on the
# server — a session cookie sent in clear is a session handed to whoever
# shares the network.
COOKIE_SECURE=1
COOKIE_SAMESITE=lax
# Only needed to share the session across subdomains.
COOKIE_DOMAIN=

# Where the SQLite databases live. Defaults to ./data next to the code.
SHAZAMER_DATA_DIR=
