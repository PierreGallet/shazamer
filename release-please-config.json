{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "always-update": true,
  "packages": {
    ".": {
      "release-type": "python",
      "changelog-sections": [
        {
          "type": "feat",
          "section": "✨ Features"
        },
        {
          "type": "fix",
          "section": "🐛 Fixes"
        },
        {
          "type": "perf",
          "section": "🚀 Performance"
        },
        {
          "type": "refactor",
          "section": "♻️ Refactoring"
        },
        {
          "type": "docs",
          "section": "📚 Documentation"
        },
        {
          "type": "test",
          "section": "🧪 Tests"
        },
        {
          "type": "chore",
          "section": "🧹 Maintenance",
          "hidden": true
        },
        {
          "type": "style",
          "section": "🧹 Maintenance",
          "hidden": true
        }
      ]
    }
  }
}
